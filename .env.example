# Copy to .env. Every value here works with docker compose up; nothing is secret.

# Postgres superuser, used by migrations and the seed script
DATABASE_URL=postgres://postgres:postgres@localhost:5432/renewal_tracker
# Role the API connects as. It cannot bypass row-level security.
APP_DATABASE_URL=postgres://app:app@localhost:5432/renewal_tracker
# Role the reminder worker connects as. It reads across tenants; see docs/adr/003.
WORKER_DATABASE_URL=postgres://worker:worker@localhost:5432/renewal_tracker

API_PORT=3000
WEB_PORT=5173

# console or smtp. smtp points at Mailpit from docker compose.
EMAIL_TRANSPORT=console
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=reminders@renewal-tracker.local

# How often the worker looks for due reminders, in seconds
WORKER_INTERVAL_SECONDS=60
